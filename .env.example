# Relay server
PORT=8787
# Provider selection: ASR mock|deepgram, MT mock|openai|groq, TTS mock|elevenlabs
ASR_PROVIDER=mock
MT_PROVIDER=mock
TTS_PROVIDER=mock
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Groq model (OpenAI-compatible). gpt-oss-20b: ~150 ms first token; gpt-oss-120b: better fluency, ~500 ms
GROQ_MODEL=openai/gpt-oss-20b
ELEVENLABS_API_KEY=
# Optional: premade/your own voice id (free tier cannot use library voices)
ELEVENLABS_VOICE_ID=
