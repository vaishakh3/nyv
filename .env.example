# Relay server
PORT=8787
# Provider selection: ASR mock|deepgram|deepgram-nova|deepgram-flux, MT mock|openai|groq, TTS mock|elevenlabs
ASR_PROVIDER=mock
MT_PROVIDER=mock
# Optional second MT provider for when the first fails/stalls before its first token
MT_FALLBACK_PROVIDER=
TTS_PROVIDER=mock
# "deepgram" uses Flux (turn-aware, English only) for English sources and Nova-3 otherwise; DEEPGRAM_FLUX=0 forces Nova-3
DEEPGRAM_FLUX=1
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
# Groq model (OpenAI-compatible). gpt-oss-20b: ~150 ms first token; gpt-oss-120b: better fluency, ~500 ms
GROQ_MODEL=openai/gpt-oss-20b
# Optional Groq model for Malayalam only (120b: better prose, but 1.6-2.9 s first-token spikes on the free tier); empty keeps GROQ_MODEL
GROQ_MODEL_ML=
ELEVENLABS_API_KEY=
# Optional: premade/your own voice id (free tier cannot use library voices)
ELEVENLABS_VOICE_ID=
# Target languages Flash v2.5 cannot speak go to the Text-to-Dialogue endpoint (v4 Turbo, ~160 ms first byte)
ELEVENLABS_DIALOGUE_LANGS=ml
ELEVENLABS_DIALOGUE_MODEL=eleven_v4_turbo
