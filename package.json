{
  "name": "parley",
  "private": true,
  "version": "0.0.0",
  "description": "Real-time speech-to-speech translation for video calls",
  "license": "MIT",
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "bench": "pnpm --filter @parley/bench start",
    "check": "pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/node": "^22.10.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0"
  }
}
